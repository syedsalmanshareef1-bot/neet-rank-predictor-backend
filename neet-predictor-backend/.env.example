# --- Database ---
DATABASE_URL=postgresql+psycopg2://neet_user:neet_password@localhost:5432/neet_predictor

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Add the URL(s) where the predictor frontend is hosted.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,null

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=NEET Rank Predictor API

# --- Bootstrap admin (used only by scripts/create_admin.py) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-this-password
